# Copy to config/task008.env (do not commit real credentials).

# Local isolation defaults only — company Broker params stay out of the repo.

# Do NOT point at 18089 (existing reviewed core). Use a free isolated port.



TASK008_MQTT_HOST=127.0.0.1

TASK008_MQTT_PORT=1883

TASK008_MQTT_USER=fusion_local

TASK008_MQTT_PASSWORD=fusion_local_dev_only

TASK008_MQTT_CLIENT_ID=fusion-mqtt-adapter-001



TASK008_TENANT_ID=tenant-demo

TASK008_SITE_ID=site-demo

TASK008_TOPIC_PREFIX=fusion/v1



# Isolated FastAPI fusion core for TASK-008 (bind 127.0.0.1:18099).

# Example: uvicorn fusion_mvp.api:app --host 127.0.0.1 --port 18099

TASK008_HTTP_BASE=http://127.0.0.1:18099



TASK008_SQLITE_PATH=data/task008/mqtt_adapter.sqlite3

TASK008_RECEIVER_SQLITE=data/task008/mqtt_receiver.sqlite3

TASK008_MAX_INBOX=50000

TASK008_DONE_RETAIN=100000

TASK008_HTTP_TIMEOUT_S=30

TASK008_HTTP_RETRIES=3

TASK008_MAX_SESSION_WORKERS=4

TASK008_IDLE_TICK_S=2

TASK008_LOG_LEVEL=INFO


