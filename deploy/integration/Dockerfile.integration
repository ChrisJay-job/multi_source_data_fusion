FROM python:3.11-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/src
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY src/ /app/src/
COPY config/fusion.yaml /app/config/fusion.yaml
COPY config/field_mapping.example.yaml /app/config/field_mapping.example.yaml
COPY demo/ /app/demo/
COPY scripts/ /app/scripts/
RUN groupadd --gid 10001 fusion && useradd --uid 10001 --gid 10001 --no-create-home fusion && mkdir -p /app/data/uploads /app/scenarios && chown -R 10001:10001 /app/data /app/scenarios
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "fusion_mvp.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
