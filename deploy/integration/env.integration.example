# Copy to .env.integration; never commit actual credentials.
FUSION_IMAGE=fusion-integration:replace-with-commit
FUSION_BIND_IP=127.0.0.1
FUSION_HTTP_PORT=18099
FUSION_DATA_DIR=/srv/fusion-integration/shared/data
TASK008_MQTT_HOST=REPLACE_WITH_APPROVED_PRIVATE_BROKER
TASK008_MQTT_PORT=1883
TASK008_MQTT_USER=REPLACE_WITH_ACCOUNT
TASK008_MQTT_PASSWORD=REPLACE_WITH_SECRET
TASK008_MQTT_CLIENT_ID=fusion-adapter-integration-unique-001
TASK008_TENANT_ID=REPLACE_WITH_TENANT
TASK008_SITE_ID=REPLACE_WITH_SITE
TASK008_TOPIC_PREFIX=fusion/v1
TASK008_HTTP_BASE=http://fusion-core:8000
TASK008_SQLITE_PATH=/app/data/task008/mqtt_adapter.sqlite3
TASK008_MAX_INBOX=50000
TASK008_DONE_RETAIN=100000
TASK008_MAX_SESSION_WORKERS=4
TASK008_HTTP_TIMEOUT_S=30
TASK008_HTTP_RETRIES=3
TASK008_IDLE_TICK_S=2
TASK008_REORDER_WINDOW_S=2
TASK008_PUBLISH_TIMEOUT_S=10
TASK008_LOG_LEVEL=INFO
